{% extends 'base.html.twig' %}

{% block title %}Viewer - CloudServe{% endblock %}

{% block body %}
<div class="fixed inset-0 flex flex-col bg-black overflow-hidden">
    <!-- Header -->
    <div class="bg-black/90 text-white px-6 py-4 flex justify-between items-center border-b border-white/10 backdrop-blur-md z-50">
        <div class="flex items-center gap-4">
            <button class="flex items-center gap-2 px-4 py-2 bg-red-500/20 text-white border border-red-500/50 rounded-lg hover:bg-red-500/40 transition-all text-sm" onclick="closeViewer()">
                ✕ Fermer
            </button>
            <h1 class="text-lg font-semibold max-w-md truncate" id="file-title">Chargement...</h1>
        </div>
        <div class="flex items-center gap-2">
            <button class="flex items-center gap-2 px-4 py-2 bg-white/10 text-white border border-white/20 rounded-lg hover:bg-white/20 hover:border-white/40 transition-all text-sm hidden" id="btn-save" onclick="saveTextFile()">
                💾 Enregistrer
            </button>
            <button class="flex items-center gap-2 px-4 py-2 bg-white/10 text-white border border-white/20 rounded-lg hover:bg-white/20 hover:border-white/40 transition-all text-sm" onclick="downloadFile()">
                ⬇️ Télécharger
            </button>
        </div>
    </div>

    <!-- Content -->
    <div class="flex-1 flex items-center justify-center relative overflow-hidden" id="viewer-content">
        <div class="text-white text-xl animate-pulse">Chargement du fichier...</div>

        <button class="absolute left-8 top-1/2 -translate-y-1/2 w-14 h-14 bg-black/50 text-white rounded-full flex items-center justify-center hover:bg-white/20 hover:scale-110 transition-all z-10 text-2xl disabled:opacity-30 disabled:cursor-not-allowed hidden" id="nav-prev" onclick="navigateFile('prev')">
            ‹
        </button>
        <button class="absolute right-8 top-1/2 -translate-y-1/2 w-14 h-14 bg-black/50 text-white rounded-full flex items-center justify-center hover:bg-white/20 hover:scale-110 transition-all z-10 text-2xl disabled:opacity-30 disabled:cursor-not-allowed hidden" id="nav-next" onclick="navigateFile('next')">
            ›
        </button>
    </div>
</div>

<script>
const fileId = {{ fileId }};
const token = localStorage.getItem('auth_token');
let currentFile = null;
let allFiles = [];
let currentIndex = -1;
let isEditing = false;

// Cache pour les fichiers préchargés
let preloadCache = new Map();

// Récupérer le parent_id de l'URL pour garder le contexte du dossier
const urlParams = new URLSearchParams(window.location.search);
const parentId = urlParams.get('parent_id');

if (!token) {
    window.location.href = '/login-page';
}

function closeViewer() {
    if (isEditing) {
        if (!confirm('Vous avez des modifications non enregistrées. Voulez-vous vraiment quitter ?')) {
            return;
        }
    }

    // Nettoyer les blob URLs pour libérer la mémoire
    preloadCache.forEach((blobUrl, id) => {
        if (typeof blobUrl === 'string' && blobUrl.startsWith('blob:')) {
            URL.revokeObjectURL(blobUrl);
        }
    });
    preloadCache.clear();

    // Retourner à la page précédente (dashboard) sans recharger
    window.history.back();
}

async function loadFile(id) {
    const content = document.getElementById('viewer-content');
    content.innerHTML = '<div class="text-white text-xl animate-pulse">Chargement...</div>';

    try {
        // Charger la liste de tous les fichiers pour la navigation
        await loadAllFiles();

        // Charger le contenu du fichier
        await loadFileContent(id);

        updateTitle();
        updateNavigation();

    } catch (error) {
        content.innerHTML = `
            <div class="bg-red-500/10 text-red-400 p-8 rounded-2xl text-center max-w-lg border border-red-500/20">
                <p class="text-xl font-bold mb-2">❌ Erreur lors du chargement</p>
                <p class="text-sm opacity-80">${error.message}</p>
            </div>
        `;
    }
}

async function loadAllFiles() {
    try {
        // Charger les fichiers du même dossier que le fichier actuel
        const url = parentId ? `/files?parent_id=${parentId}` : '/files';
        const response = await fetch(url, {
            headers: { 'X-Auth-Token': token }
        });

        if (response.ok) {
            const data = await response.json();
            allFiles = data.files.filter(f => !f.isFolder);
            currentIndex = allFiles.findIndex(f => f.id === fileId);
        }
    } catch (error) {
        console.error('Error loading files list:', error);
    }
}

function displayImage(id) {
    const content = document.getElementById('viewer-content');
    content.innerHTML = `
        <img src="/files/${id}/view" class="max-w-full max-h-full object-contain" alt="Image">
        ${getNavButtons()}
    `;
}

function displayVideo(id) {
    const content = document.getElementById('viewer-content');
    content.innerHTML = `
        <video controls class="max-w-full max-h-full object-contain" autoplay>
            <source src="/files/${id}/view" type="video/mp4">
            Votre navigateur ne supporte pas la lecture de vidéos.
        </video>
        ${getNavButtons()}
    `;
}

function displayAudio(id) {
    const content = document.getElementById('viewer-content');
    content.innerHTML = `
        <div class="text-center text-white">
            <div class="text-6xl mb-8">🎵</div>
            <audio controls autoplay class="w-[90vw] max-w-xl">
                <source src="/files/${id}/view">
                Votre navigateur ne supporte pas la lecture audio.
            </audio>
        </div>
        ${getNavButtons()}
    `;
}

function displayPdf(id) {
    const content = document.getElementById('viewer-content');
    content.innerHTML = `
        <iframe src="/files/${id}/view" class="w-full h-full border-none"></iframe>
        ${getNavButtons()}
    `;
}

function displayTextFile(data) {
    const content = document.getElementById('viewer-content');
    content.innerHTML = `
        <textarea class="w-[90%] max-w-6xl h-[80%] bg-[#1e1e1e] text-[#d4d4d4] p-8 font-mono text-sm border-none rounded-xl resize-none focus:outline-none focus:ring-2 focus:ring-primary-500 shadow-2xl" id="text-content" oninput="markAsEdited()">${data.content || ''}</textarea>
        ${getNavButtons()}
    `;

    const saveBtn = document.getElementById('btn-save');
    if (saveBtn) saveBtn.classList.remove('hidden');
    currentFile = data;
}

function getNavButtons() {
    return `
        <button class="absolute left-8 top-1/2 -translate-y-1/2 w-14 h-14 bg-black/50 text-white rounded-full flex items-center justify-center hover:bg-white/20 hover:scale-110 transition-all z-10 text-2xl disabled:opacity-30 disabled:cursor-not-allowed" id="nav-prev" onclick="navigateFile('prev')">‹</button>
        <button class="absolute right-8 top-1/2 -translate-y-1/2 w-14 h-14 bg-black/50 text-white rounded-full flex items-center justify-center hover:bg-white/20 hover:scale-110 transition-all z-10 text-2xl disabled:opacity-30 disabled:cursor-not-allowed" id="nav-next" onclick="navigateFile('next')">›</button>
    `;
}

function markAsEdited() {
    isEditing = true;
}

async function saveTextFile() {
    const content = document.getElementById('text-content').value;
    const currentFileId = allFiles[currentIndex]?.id || fileId;

    try {
        const response = await fetch(`/files/${currentFileId}/content`, {
            method: 'PUT',
            headers: {
                'X-Auth-Token': token,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ content })
        });

        if (response.ok) {
            isEditing = false;
            // Utiliser le toast global si disponible, sinon alert
            if (window.ui && window.ui.toast) {
                window.ui.toast('Fichier enregistré avec succès', 'success');
            } else {
                alert('✅ Fichier enregistré avec succès');
            }
        } else {
            const error = await response.json();
            alert('❌ Erreur: ' + (error.error || 'Impossible de sauvegarder'));
        }
    } catch (error) {
        alert('❌ Erreur de connexion au serveur');
    }
}

function updateTitle() {
    if (currentFile && currentFile.filename) {
        document.getElementById('file-title').textContent = currentFile.filename;
    } else if (allFiles[currentIndex]) {
        document.getElementById('file-title').textContent = allFiles[currentIndex].filename;
    }
}

function updateNavigation() {
    const prevBtn = document.getElementById('nav-prev');
    const nextBtn = document.getElementById('nav-next');

    if (prevBtn && nextBtn) {
        prevBtn.disabled = currentIndex <= 0;
        nextBtn.disabled = currentIndex >= allFiles.length - 1;
        
        // Si un seul fichier, cacher les boutons
        if (allFiles.length <= 1) {
            prevBtn.style.display = 'none';
            nextBtn.style.display = 'none';
        } else {
            prevBtn.style.display = 'flex';
            nextBtn.style.display = 'flex';
        }
    }

    preloadAdjacentFiles();
}

// Précharger les images/vidéos adjacentes pour une navigation instantanée
async function preloadAdjacentFiles() {
    const filesToPreload = [];

    for (let offset = -2; offset <= 2; offset++) {
        if (offset === 0) continue;
        const index = currentIndex + offset;
        if (index >= 0 && index < allFiles.length) {
            const file = allFiles[index];
            if (file.type === 'image' || file.type === 'video') {
                filesToPreload.push(file);
            }
        }
    }

    for (const file of filesToPreload) {
        if (!preloadCache.has(file.id)) {
            try {
                if (file.type === 'image') {
                    const response = await fetch(`/files/${file.id}/view`, {
                        headers: { 'X-Auth-Token': token }
                    });

                    if (response.ok) {
                        const blob = await response.blob();
                        const blobUrl = URL.createObjectURL(blob);
                        preloadCache.set(file.id, blobUrl);
                    }
                } else if (file.type === 'video') {
                    const response = await fetch(`/files/${file.id}/view`, {
                        headers: { 'X-Auth-Token': token }
                    });

                    if (response.ok) {
                        const blob = await response.blob();
                        const blobUrl = URL.createObjectURL(blob);
                        preloadCache.set(file.id, blobUrl);
                    }
                }
            } catch (error) {
                console.warn('Preload failed for file', file.id, error);
            }
        }
    }
}

async function navigateFile(direction) {
    if (isEditing && !confirm('Vous avez des modifications non enregistrées. Continuer ?')) {
        return;
    }

    const newIndex = direction === 'prev' ? currentIndex - 1 : currentIndex + 1;

    if (newIndex >= 0 && newIndex < allFiles.length) {
        currentIndex = newIndex;
        const newFile = allFiles[currentIndex];

        const url = parentId ? `/viewer/${newFile.id}?parent_id=${parentId}` : `/viewer/${newFile.id}`;
        window.history.replaceState({ fileId: newFile.id }, '', url);

        await loadFileContent(newFile.id);
        updateTitle();
        updateNavigation();
    }
}

async function loadFileContent(id) {
    const content = document.getElementById('viewer-content');
    const fileInfo = allFiles[currentIndex];

    if (fileInfo && fileInfo.type === 'image' && preloadCache.has(id)) {
        displayImageFromCache(id);
        return;
    }

    try {
        const fileResponse = await fetch(`/files/${id}/view`, {
            headers: { 'X-Auth-Token': token }
        });

        if (fileResponse.status === 202) {
            const data = await fileResponse.json();
            content.innerHTML = `
                <div class="text-center text-white max-w-lg">
                    <div class="text-6xl mb-8 animate-pulse">⏳</div>
                    <h2 class="text-2xl font-bold mb-4">Fichier en cours de traitement</h2>
                    <p class="text-white/70 mb-8">
                        Le fichier "${data.filename}" est en train d'être compressé et optimisé.<br>
                        Cela prendra quelques instants...
                    </p>
                    <button class="px-6 py-3 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors" onclick="loadFileContent(${id})">
                        🔄 Recharger
                    </button>
                </div>
            `;
            return;
        }

        if (!fileResponse.ok) {
            throw new Error('Impossible de charger le fichier');
        }

        const contentType = fileResponse.headers.get('Content-Type');

        if (contentType.includes('application/json')) {
            const data = await fileResponse.json();
            currentFile = data;
            if (data.type === 'text') {
                displayTextFile(data);
            }
        } else if (contentType.startsWith('image/')) {
            displayImage(id);
        } else if (contentType.startsWith('video/')) {
            displayVideo(id);
        } else if (contentType.startsWith('audio/')) {
            displayAudio(id);
        } else if (contentType.includes('pdf')) {
            displayPdf(id);
        } else {
            content.innerHTML = `
                <div class="bg-white/10 p-8 rounded-2xl text-center max-w-lg border border-white/20">
                    <p class="text-lg mb-4">⚠️ Ce type de fichier ne peut pas être visualisé directement.</p>
                    <button class="px-6 py-3 bg-white text-slate-900 font-bold rounded-xl hover:bg-slate-200 transition-colors" onclick="window.location.href='/files/${id}/download'">
                        ⬇️ Télécharger le fichier
                    </button>
                </div>
            `;
        }
    } catch (error) {
        content.innerHTML = `
            <div class="bg-red-500/10 text-red-400 p-8 rounded-2xl text-center max-w-lg border border-red-500/20">
                <p class="text-xl font-bold mb-2">❌ Erreur lors du chargement</p>
                <p class="text-sm opacity-80">${error.message}</p>
            </div>
        `;
    }
}

function displayImageFromCache(id) {
    const content = document.getElementById('viewer-content');
    const blobUrl = preloadCache.get(id);

    content.innerHTML = `
        <img src="${blobUrl}" class="max-w-full max-h-full object-contain opacity-0 transition-opacity duration-200" alt="Image">
        ${getNavButtons()}
    `;

    setTimeout(() => {
        const img = content.querySelector('img');
        if (img) img.classList.remove('opacity-0');
    }, 10);
}

function downloadFile() {
    const currentFileId = allFiles[currentIndex]?.id || fileId;
    window.location.href = `/files/${currentFileId}/download`;
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
        navigateFile('prev');
    } else if (e.key === 'ArrowRight') {
        navigateFile('next');
    } else if (e.key === 'Escape') {
        closeViewer();
    }
});

window.addEventListener('popstate', async (e) => {
    if (e.state && e.state.fileId) {
        currentIndex = allFiles.findIndex(f => f.id === e.state.fileId);
        if (currentIndex !== -1) {
            await loadFileContent(e.state.fileId);
            updateTitle();
            updateNavigation();
        }
    }
});

loadFile(fileId);
</script>
{% endblock %}
