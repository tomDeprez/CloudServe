function updateFilesManagerCount() {
    const count = document.getElementById('files-manager-count');
    count.textContent = `(${filteredUserFiles.length})`;
}

function filterFiles() {
    const searchInput = document.getElementById('files-search');
    const searchTerm = searchInput.value.toLowerCase();

    if (searchTerm === '') {
        filteredUserFiles = [...allUserFiles];
    } else {
        filteredUserFiles = allUserFiles.filter(file =>
            file.filename.toLowerCase().includes(searchTerm) ||
            file.path.toLowerCase().includes(searchTerm)
        );
    }

    updateFilesManagerCount();
    renderFilesList();
}

function renderFilesList() {
    const listContainer = document.getElementById('files-manager-list');

    if (filteredUserFiles.length === 0) {
        listContainer.innerHTML = '<div class="files-manager-loading">Aucun fichier trouvé</div>';
        return;
    }

    const html = filteredUserFiles.map(file => {
        const icon = file.isFolder ? '📁' : getFileIcon(file);
        const size = formatSize(file.size);

        return `
            <div class="files-manager-item" onclick="navigateToFileInManager(${file.id}, ${file.isFolder})" title="${file.path}">
                <div class="files-manager-item-icon">${icon}</div>
                <div class="files-manager-item-info">
                    <div class="files-manager-item-name">${escapeHtml(file.filename)}</div>
                    <div class="files-manager-item-path">${escapeHtml(file.path)}</div>
                </div>
                <div class="files-manager-item-meta">
                    <div>${size}</div>
                    <div>${formatDate(file.uploadedAt)}</div>
                </div>
            </div>
        `;
    }).join('');

    listContainer.innerHTML = html;
}

function navigateToFileInManager(fileId, isFolder) {
    closeFilesManager();

    if (isFolder) {
        navigateToFolder(fileId);
    } else {
        // Ouvrir le fichier dans le viewer
        const file = allUserFiles.find(f => f.id === fileId);
        if (file) {
            window.location.href = `/viewer/${fileId}`;
        }
    }
}

function formatDate(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now - date;
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

    if (diffDays === 0) return 'Aujourd\'hui';
    if (diffDays === 1) return 'Hier';
    if (diffDays < 7) return `Il y a ${diffDays}j`;
    if (diffDays < 30) return `Il y a ${Math.floor(diffDays / 7)}sem`;
    if (diffDays < 365) return `Il y a ${Math.floor(diffDays / 30)}m`;
    return `Il y a ${Math.floor(diffDays / 365)}a`;
}

// Rendre la popup draggable
let isDragging = false;
let dragOffsetX = 0;
let dragOffsetY = 0;

const popup = document.getElementById('files-manager-popup');
const header = popup.querySelector('.files-manager-header');

header.addEventListener('mousedown', (e) => {
    if (e.target.tagName === 'BUTTON' || e.target.closest('button')) {
        return; // Ne pas drag si on clique sur un bouton
    }

    isDragging = true;
    const rect = popup.getBoundingClientRect();
    dragOffsetX = e.clientX - rect.left;
    dragOffsetY = e.clientY - rect.top;
    popup.style.transition = 'none';
});

document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;

    const x = e.clientX - dragOffsetX;
    const y = e.clientY - dragOffsetY;

    popup.style.left = x + 'px';
    popup.style.top = y + 'px';
    popup.style.right = 'auto';
    popup.style.bottom = 'auto';
});

document.addEventListener('mouseup', () => {
    if (isDragging) {
        isDragging = false;
        popup.style.transition = 'all 0.3s ease';
    }
});

