// Drag & Drop between folders
let draggedFileId = null;

function handleDragStart(e) {
    const draggedFileId = parseInt(e.target.dataset.fileId);
    e.target.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';

    // Si le fichier draggé est sélectionné, déplacer tous les fichiers sélectionnés
    if (selectedFiles.has(draggedFileId)) {
        draggedFiles = new Set(selectedFiles);
    } else {
        draggedFiles = new Set([draggedFileId]);
    }

    // Afficher le nombre de fichiers dans le drag
    e.dataTransfer.setData('text/plain', draggedFiles.size);
}

function handleDragEnd(e) {
    e.target.classList.remove('dragging');
    // Ne pas vider draggedFiles ici, on le fait après le drop
}

function handleDragOver(e) {
    e.preventDefault();
    const target = e.currentTarget;
    const file = allFiles.find(f => f.id == target.dataset.fileId);

    // Vérifier qu'on ne drag pas un dossier sur lui-même ou sur un fichier sélectionné
    if (file && file.isFolder && !draggedFiles.has(file.id)) {
        target.style.borderColor = 'var(--primary)';
        target.style.backgroundColor = 'rgba(99, 102, 241, 0.1)';
        e.dataTransfer.dropEffect = 'move';
    }
}

function handleDragLeave(e) {
    e.currentTarget.style.borderColor = '';
    e.currentTarget.style.backgroundColor = '';
}

async function handleDrop(e) {
    e.preventDefault();
    e.stopPropagation();

    const targetElement = e.currentTarget;
    targetElement.style.borderColor = '';
    targetElement.style.backgroundColor = '';

    const targetFileId = parseInt(targetElement.dataset.fileId);
    const targetFile = allFiles.find(f => f.id == targetFileId);

    // Vérifier que c'est bien un dossier et qu'il n'est pas dans les fichiers à déplacer
    if (!targetFile || !targetFile.isFolder || draggedFiles.has(targetFileId)) {
        draggedFiles.clear();
        return;
    }

    // Déplacer tous les fichiers sélectionnés
    await moveSelectedFilesToFolder(targetFileId);
}

